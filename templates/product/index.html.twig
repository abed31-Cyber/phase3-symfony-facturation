{% extends 'layout.html.twig' %}
{% block title %}Produits & Services{% endblock %}

{% block content %}

{% if show_modal is defined and show_modal %}
{# ===== MODAL (form errors) ===== #}
<div style="text-align:center; margin-bottom:28px;">
    <h2 style="font-size:18px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#111827;">AJOUTER UN NOUVEAU PRODUIT</h2>
</div>
<div style="max-width:520px;margin:0 auto 40px;">
    <div class="modal" style="position:relative;display:block;box-shadow:0 4px 24px rgba(0,0,0,.12);">
        <h3 class="modal-title">Nouveau produit</h3>
        {{ include('product/_form.html.twig', {form: form, btn_label: 'Enregistrer'}) }}
    </div>
</div>
{% endif %}

{# ===== PAGE HEADER + button ===== #}
{% if not (show_modal is defined and show_modal) %}
<div class="page-header">
    <h1 class="page-title">Produits & Services</h1>
    <button class="btn btn-primary" onclick="document.getElementById('product-modal').style.display='flex'">
        + Ajouter un produit
    </button>
</div>

{# ===== ADD MODAL ===== #}
<div id="product-modal" class="modal-overlay" style="display:none;">
    <div class="modal">
        <button class="modal-close" onclick="document.getElementById('product-modal').style.display='none'">✕</button>
        <h3 class="modal-title">Nouveau produit</h3>
        {{ include('product/_form.html.twig', {form: form, btn_label: 'Enregistrer'}) }}
    </div>
</div>
{% endif %}

{# ===== LIST ===== #}
{% if show_modal is defined and show_modal %}
<h2 style="font-size:18px;font-weight:700;text-align:center;margin-bottom:20px;">Produits & Services existant</h2>
{% endif %}

<div class="card" style="padding:0;overflow:hidden;">
    <table class="data-table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Description</th>
                <th>Prix unitaire</th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr>
                <td class="fw-semibold">{{ product.name }}</td>
                <td class="text-muted">{{ product.description }}</td>
                <td>{{ product.price|number_format(0, ',', ' ') }} €{% if product.unit %} / {{ product.unit }}{% endif %}</td>
                <td>
                    <div class="actions">
                        <a href="{{ path('app_product_edit', {id: product.id}) }}" class="btn-icon edit" title="Modifier">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                        </a>
                        <form method="post" action="{{ path('app_product_delete', {id: product.id}) }}"
                              onsubmit="return confirm('Supprimer ce produit ?')" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-product-' ~ product.id) }}">
                            <button type="submit" class="btn-icon delete" title="Supprimer">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                    <path d="M10 11v6"/><path d="M14 11v6"/>
                                    <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                                </svg>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="4" style="text-align:center;color:#9CA3AF;padding:32px;">Aucun produit pour le moment.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
