{% extends 'layout.html.twig' %}
{% block title %}Modifier un produit{% endblock %}

{% block content %}
<a href="{{ path('app_product_index') }}" class="page-back">← Retour aux produits</a>

<div class="page-header">
    <h1 class="page-title">Modifier le produit</h1>
</div>

<div class="card" style="max-width:520px;">
    {{ form_start(form, {action: path('app_product_edit', {id: product.id}), method: 'POST'}) }}

    <div class="form-group">
        {{ form_label(form.name, null, {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.name, {attr: {class: 'form-control'}}) }}
        {{ form_errors(form.name) }}
    </div>
    <div class="form-group">
        {{ form_label(form.description, null, {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.description, {attr: {class: 'form-control'}}) }}
    </div>
    <div class="form-row">
        <div class="form-group">
            {{ form_label(form.price, null, {label_attr: {class: 'form-label'}}) }}
            {{ form_widget(form.price, {attr: {class: 'form-control'}}) }}
            {{ form_errors(form.price) }}
        </div>
        <div class="form-group">
            {{ form_label(form.unit, null, {label_attr: {class: 'form-label'}}) }}
            {{ form_widget(form.unit, {attr: {class: 'form-control'}}) }}
        </div>
    </div>

    <div class="d-flex gap-3 justify-end mt-4">
        <a href="{{ path('app_product_index') }}" class="btn btn-secondary">Annuler</a>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
