{{ form_start(form, {action: path('app_product_index'), method: 'POST'}) }}

<div class="form-group">
    {{ form_label(form.name, null, {label_attr: {class: 'form-label'}}) }}
    {{ form_widget(form.name, {attr: {class: 'form-control'}}) }}
    {{ form_errors(form.name) }}
</div>

<div class="form-group">
    {{ form_label(form.description, null, {label_attr: {class: 'form-label'}}) }}
    {{ form_widget(form.description, {attr: {class: 'form-control'}}) }}
</div>

<div class="form-row">
    <div class="form-group">
        {{ form_label(form.price, null, {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.price, {attr: {class: 'form-control'}}) }}
        {{ form_errors(form.price) }}
    </div>
    <div class="form-group">
        {{ form_label(form.unit, null, {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.unit, {attr: {class: 'form-control'}}) }}
    </div>
</div>

<div class="modal-actions">
    <button type="button" class="btn btn-secondary"
            onclick="document.getElementById('product-modal').style.display='none'">Annuler</button>
    <button type="submit" class="btn btn-primary">{{ btn_label|default('Enregistrer') }}</button>
</div>

{{ form_end(form) }}
