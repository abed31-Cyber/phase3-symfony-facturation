{% extends 'layout.html.twig' %}
{% block title %}Mon Profil{% endblock %}

{% block content %}
<div class="page-header">
    <h1 class="page-title">Mon Profil</h1>
</div>

<div class="profile-card">
    {{ form_start(form) }}

    <div class="form-group">
        {{ form_label(form.compagnyName, null, {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.compagnyName, {attr: {class: 'form-control'}}) }}
        {% if form.compagnyName.vars.help is defined %}
            <p class="form-hint">{{ form.compagnyName.vars.help }}</p>
        {% endif %}
        {{ form_errors(form.compagnyName) }}
    </div>

    <div class="form-group">
        {{ form_label(form.siret, null, {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.siret, {attr: {class: 'form-control'}}) }}
    </div>

    <div class="form-group">
        {{ form_label(form.iban, null, {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.iban, {attr: {class: 'form-control'}}) }}
        {% if form.iban.vars.help is defined %}
            <p class="form-hint">{{ form.iban.vars.help }}</p>
        {% endif %}
    </div>

    <div class="form-group">
        {{ form_label(form.cgv, null, {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.cgv, {attr: {class: 'form-control'}}) }}
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
