{% extends 'layout.html.twig' %}
{% block title %}Factures{% endblock %}

{% block content %}
<div class="page-header">
    <h1 class="page-title">Factures</h1>
    <a href="{{ path('app_invoice_new') }}" class="btn btn-primary">+ Nouvelle facture</a>
</div>

<div class="card" style="padding:0;overflow:hidden;">
    <table class="data-table">
        <thead>
            <tr>
                <th>Numéro</th>
                <th>Client</th>
                <th>Date</th>
                <th>Échéance</th>
                <th>Statut</th>
                <th>Total TTC</th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for invoice in invoices %}
            <tr>
                <td class="fw-semibold">{{ invoice.number }}</td>
                <td>{{ invoice.client ? invoice.client.compagnyName ?: (invoice.client.name ~ ' ' ~ invoice.client.lastName) : '—' }}</td>
                <td class="text-muted">{{ invoice.createdAt|date('d/m/Y') }}</td>
                <td class="text-muted">{{ invoice.dueDate|date('d/m/Y') }}</td>
                <td>
                    {% if invoice.status == 'DRAFT' %}
                        <span class="badge badge-draft">⏱ Brouillon</span>
                    {% elseif invoice.status == 'PENDING' %}
                        <span class="badge badge-pending">⏰ En attente</span>
                    {% elseif invoice.status == 'PAID' %}
                        <span class="badge badge-paid">✓ Payée</span>
                    {% else %}
                        <span class="badge badge-cancelled">✕ Annulée</span>
                    {% endif %}
                </td>
                <td class="fw-semibold">{{ invoice.totalTtc|number_format(2, ',', ' ') }} €</td>
                <td>
                    <div class="actions">
                        <a href="{{ path('app_invoice_show', {id: invoice.id}) }}" class="btn-icon edit" title="Voir">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </a>
                        <a href="{{ path('app_invoice_edit', {id: invoice.id}) }}" class="btn-icon" style="color:#6B7280;" title="Modifier">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                        </a>
                        <form method="post" action="{{ path('app_invoice_delete', {id: invoice.id}) }}"
                              onsubmit="return confirm('Supprimer cette facture ?')" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ invoice.id) }}">
                            <button type="submit" class="btn-icon delete" title="Supprimer">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                    <path d="M10 11v6"/><path d="M14 11v6"/>
                                    <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                                </svg>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7" style="text-align:center;color:#9CA3AF;padding:32px;">Aucune facture pour le moment.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
