{% extends 'layout.html.twig' %}
{% block title %}Clients{% endblock %}

{% block content %}
<div class="page-header">
    <h1 class="page-title">Clients</h1>
    <button class="btn btn-primary" onclick="document.getElementById('client-modal').style.display='flex'">
        + Ajouter un client
    </button>
</div>

{# ===== ADD MODAL ===== #}
<div id="client-modal" class="modal-overlay" style="display:{{ show_modal is defined and show_modal ? 'flex' : 'none' }};">
    <div class="modal" style="width:560px;">
        <button class="modal-close" onclick="document.getElementById('client-modal').style.display='none'">✕</button>
        <h3 class="modal-title">Nouveau client</h3>

        {{ form_start(form) }}
        <div class="form-group">
            <label class="form-label">Nom du client / Entreprise</label>
            <div class="form-row">
                {{ form_widget(form.name, {attr: {class: 'form-control', placeholder: 'Prénom'}}) }}
                {{ form_widget(form.last_name, {attr: {class: 'form-control', placeholder: 'Nom'}}) }}
            </div>
            {{ form_errors(form.name) }}
        </div>
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Email</label>
                {{ form_widget(form.email, {attr: {class: 'form-control'}}) }}
                {{ form_errors(form.email) }}
            </div>
            <div class="form-group">
                <label class="form-label">Téléphone</label>
                {{ form_widget(form.phone, {attr: {class: 'form-control'}}) }}
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Adresse</label>
            {{ form_widget(form.adress, {attr: {class: 'form-control'}}) }}
        </div>
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Code postal</label>
                {{ form_widget(form.codePostal, {attr: {class: 'form-control'}}) }}
            </div>
            <div class="form-group">
                <label class="form-label">Ville</label>
                {{ form_widget(form.ville, {attr: {class: 'form-control'}}) }}
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Raison Sociale (Optionnel)</label>
            {{ form_widget(form.compagny_name, {attr: {class: 'form-control'}}) }}
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary"
                    onclick="document.getElementById('client-modal').style.display='none'">Annuler</button>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>
        {{ form_end(form) }}
    </div>
</div>

{# ===== LIST ===== #}
<div class="card" style="padding:0;overflow:hidden;">
    <table class="data-table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Contact</th>
                <th>Adresse</th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for client in clients %}
            <tr>
                <td class="fw-semibold">{{ client.compagnyName ?: (client.name ~ ' ' ~ client.lastName) }}</td>
                <td>
                    <div>{{ client.email }}</div>
                    <div class="text-muted" style="font-size:12px;">{{ client.phone }}</div>
                </td>
                <td class="text-muted">{{ client.adress }}, {{ client.codePostal }} {{ client.ville }}</td>
                <td>
                    <div class="actions">
                        <a href="{{ path('app_client_edit', {id: client.id}) }}" class="btn-icon edit" title="Modifier">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                        </a>
                        <form method="post" action="{{ path('app_client_delete', {id: client.id}) }}"
                              onsubmit="return confirm('Supprimer ce client ?')" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">
                            <button type="submit" class="btn-icon delete" title="Supprimer">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                    <path d="M10 11v6"/><path d="M14 11v6"/>
                                    <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                                </svg>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="4" style="text-align:center;color:#9CA3AF;padding:32px;">Aucun client pour le moment.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
